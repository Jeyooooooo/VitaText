<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.Pane?>

<BorderPane fx:controller="com.mycompany.nlp_finalproj.AppController"
            stylesheets="@../styles/style.css"
            styleClass="main-container"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              styleClass="app-header">

            <children>

                <!-- Left side -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <ImageView fitHeight="40"
                                   fitWidth="40"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../images/vitatext-logo.png"/>
                            </image>
                        </ImageView>

                        <Label text="VitaText"
                               styleClass="logo-text"/>
                    </children>
                </HBox>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Right side -->
                <HBox spacing="8">
                    <children>
                        <Button fx:id="btnMinimize"
                                text="–"
                                onAction="#handleMinimizeWindow"/>

                        <Button fx:id="btnExit"
                                text="✕"
                                onAction="#handleExitWindow"/>
                    </children>
                </HBox>

            </children>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
    <VBox prefWidth="280"
          spacing="20"
          styleClass="sidebar">

        <children>

            <!-- CORPUS INPUT -->
            <VBox spacing="8">

                <children>

                    <Label text="CORPUS INPUT"
                           styleClass="section-header"/>

                    <TextArea fx:id="corpusInput"
                              wrapText="true"
                              prefHeight="150"
                              styleClass="corpus-textarea"/>

                    <HBox spacing="10" maxWidth="Infinity" HBox.hgrow="ALWAYS">

    <children>

        <!-- PROCESS (expands) -->
        <Button styleClass="btn-process"
                text="Process"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS">

            <graphic>
                <SVGPath content="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
                         stroke="#FFFFFF"
                         strokeWidth="2"
                         fill="transparent"/>
            </graphic>
        </Button>

        <!-- CLEAR (fixed size) -->
        <Button styleClass="btn-clear"
                prefWidth="44"
                prefHeight="44"
                minWidth="44"
                minHeight="44"
                maxWidth="44"
                maxHeight="44"
                onAction="#handleClearInput">

            <graphic>
                <SVGPath content="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6
                                 M3 6h18
                                 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                         strokeWidth="2"
                         fill="transparent"
                         strokeLineCap="ROUND"
                         strokeLineJoin="ROUND"/>
            </graphic>
        </Button>

    </children>
</HBox>

                </children>
            </VBox>

            <!-- NAVIGATION -->
            <VBox spacing="5">

                <children>

                    <Label text="NAVIGATION"
                           styleClass="section-header"/>

                    <Button fx:id="btnDashboard"
                            text="⊞ Dashboard"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>

                </children>
            </VBox>
            
            <!-- NLP FEATURES -->
            <VBox spacing="5">

                <children>

                    <Label text="NLP FEATURES"
                           styleClass="section-header"/>

                    <Button fx:id="btnTokenization"
                            text="🏷 Tokenization"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>

                    <Button fx:id="btnLemmatization"
                            text="☷ Lemmatization"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>

                    <Button fx:id="btnPosTagging"
                            text="Ⓐ POS Tagging"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>

                    <Button fx:id="btnSentiment"
                            text="☺ Sentiment Analysis"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>
                </children>
            </VBox>

        </children>
    </VBox>
</left>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="content-scrollpane">

            <content>
                <VBox fx:id="contentArea"
                      spacing="25"
                      styleClass="dashboard-body">

                    <children>
                        <fx:include source="dashboard.fxml"/>
                        <fx:include source="tokenization.fxml"/>
                        <fx:include source="lemmatization.fxml"/>
                    </children>

                </VBox>
            </content>

        </ScrollPane>
    </center>

</BorderPane>