<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>

<BorderPane fx:controller="com.mycompany.nlp_finalproj.AppController"
            stylesheets="@../styles/style.css"
            styleClass="main-container"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              styleClass="app-header">

            <children>

                <!-- Left side -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <ImageView fitHeight="40"
                                   fitWidth="40"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../images/vitatext-logo.png"/>
                            </image>
                        </ImageView>

                        <Label text="VitaText"
                               styleClass="logo-text"/>
                    </children>
                </HBox>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Right side -->
                <HBox spacing="8">
                    <children>
                        <Button fx:id="btnMinimize"
                                text="–"
                                onAction="#handleMinimizeWindow"/>

                        <Button fx:id="btnExit"
                                text="✕"
                                onAction="#handleExitWindow"/>
                    </children>
                </HBox>

            </children>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
    <VBox prefWidth="280"
          spacing="20"
          styleClass="sidebar">

        <children>

            <!-- CORPUS INPUT -->
            <VBox spacing="8">

                <children>

                    <Label text="CORPUS INPUT"
                           styleClass="section-header"/>

                    <TextArea fx:id="corpusInput"
                              wrapText="true"
                              prefHeight="150"
                              styleClass="corpus-textarea"/>

                    <HBox spacing="10">

                        <children>

                            <Button text="▶ Process"
                                    styleClass="btn-process"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    onAction="#handleProcessExecution"/>

                            <Button text="🗑"
                                    styleClass="btn-clear"
                                    prefWidth="50"
                                    prefHeight="35"
                                    onAction="#handleClearInput"/>

                        </children>
                    </HBox>

                </children>
            </VBox>

            <!-- NAVIGATION -->
            <VBox spacing="5">

                <children>

                    <Label text="NAVIGATION"
                           styleClass="section-header"/>

                    <Button fx:id="btnDashboard"
                            text="⊞ Dashboard"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>

                </children>
            </VBox>
            
            <!-- NLP FEATURES -->
            <VBox spacing="5">

                <children>

                    <Label text="NLP FEATURES"
                           styleClass="section-header"/>

                    <Button fx:id="btnTokenization"
                            text="🏷 Tokenization"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>

                    <Button fx:id="btnLemmatization"
                            text="☷ Lemmatization"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>

                    <Button fx:id="btnPosTagging"
                            text="Ⓐ POS Tagging"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>

                    <Button fx:id="btnSentiment"
                            text="☺ Sentiment Analysis"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleNavigation"/>
                </children>
            </VBox>

        </children>
    </VBox>
</left>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="content-scrollpane">

            <content>
                <VBox fx:id="contentArea"
                      spacing="25"
                      styleClass="dashboard-body">

                    <children>
                        <fx:include source="dashboard.fxml"/>
                        <fx:include source="tokenization.fxml"/>
                        <fx:include source="lemmatization.fxml"/>
                    </children>

                </VBox>
            </content>

        </ScrollPane>
    </center>

</BorderPane>