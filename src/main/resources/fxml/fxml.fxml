<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.mycompany.nlp_finalproj.AppController" 
            stylesheets="@../styles/style.css" 
            styleClass="main-container" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1">
   
   <left>
      <VBox prefWidth="280.0" styleClass="sidebar" spacing="20.0">
          <padding>
              <Insets top="30.0" right="20.0" bottom="20.0" left="20.0"/>
          </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="logo-area">
               <children>
                  <Label text="❖" styleClass="logo-icon"/>
                  <Label text="VitaText" styleClass="logo-text"/>
               </children>
            </HBox>
            
            <VBox spacing="8.0" styleClass="sidebar-section">
               <children>
                  <Label text="CORPUS INPUT" styleClass="section-header"/>
                  <TextArea fx:id="corpusInput" wrapText="true" prefHeight="150.0" styleClass="corpus-textarea"/>
                  <HBox spacing="10.0">
                     <children>
                        <Button text="▶ Process" styleClass="btn-process" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleProcessExecution"/>
                        <Button text="🗑" styleClass="btn-clear" onAction="#handleClearInput" prefHeight="35.0" minHeight="35.0" prefWidth="50.0" minWidth="50.0"/>
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <VBox spacing="5.0" styleClass="sidebar-section">
               <children>
                  <Label text="NAVIGATION" styleClass="section-header"/>
                  <Button fx:id="btnDashboard" text="⊞  Dashboard" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavigation"/>
               </children>
            </VBox>
            
            <VBox spacing="5.0" styleClass="sidebar-section">
               <children>
                  <Label text="NLP FEATURES" styleClass="section-header"/>
                  <Button fx:id="btnTokenization" text="🏷  Tokenization" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavigation"/>
                  <Button fx:id="btnLemmatization" text="☷  Lemmatization" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavigation"/>
                  <Button fx:id="btnPosTagging" text="Ⓐ  POS Tagging" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavigation"/>
                  <Button fx:id="btnSentiment" text="☺  Sentiment Analysis" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavigation"/>
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <center>
      <VBox>
         <HBox alignment="CENTER_RIGHT" spacing="8.0" style="-fx-padding: 12 16 0 0;">
            <children>
               <Button fx:id="btnMinimize" text="–" onAction="#handleMinimizeWindow"
                       style="-fx-background-color: #E2E8F0; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-min-width: 28; -fx-max-width: 28; -fx-min-height: 28; -fx-max-height: 28; -fx-cursor: hand;"/>
               <Button fx:id="btnExit" text="✕" onAction="#handleExitWindow"
                       style="-fx-background-color: #FEE2E2; -fx-text-fill: #EF4444; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-min-width: 28; -fx-max-width: 28; -fx-min-height: 28; -fx-max-height: 28; -fx-cursor: hand;"/>
            </children>
         </HBox>

         <ScrollPane fitToWidth="true" styleClass="content-scrollpane" VBox.vgrow="ALWAYS">
            <content>
               <VBox fx:id="contentArea" spacing="25.0" styleClass="dashboard-body">
                  <children>
                     <fx:include fx:id="dashboardView" source="dashboard.fxml" visible="true" managed="true"/>
                     <fx:include fx:id="tokenizationView" source="tokenization.fxml" visible="false" managed="false"/>
                     <fx:include fx:id="lemmatizationView" source="lemmatization.fxml" visible="false" managed="false"/>
                  </children>
               </VBox>
            </content>
         </ScrollPane>
      </VBox>
   </center>
</BorderPane>