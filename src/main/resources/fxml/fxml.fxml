<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.Pane?>

<BorderPane fx:controller="com.mycompany.nlp_finalproj.AppController"
            stylesheets="@../styles/style.css"
            styleClass="main-container"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              styleClass="app-header">

            <children>

                <!-- Left side -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <ImageView fitHeight="40"
                                   fitWidth="40"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../images/vitatext-logo.png"/>
                            </image>
                        </ImageView>

                        <Label text="VitaText"
                               styleClass="logo-text"/>
                    </children>
                </HBox>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Right side -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
    <children>
        <Button fx:id="btnMinimize"
                styleClass="window-control-btn, btn-minimize"
                prefWidth="32"
                prefHeight="32"
                minWidth="32"
                minHeight="32"
                onAction="#handleMinimizeWindow">
            <graphic>
                <SVGPath content="M5 12h14"
                         styleClass="window-control-icon"/>
            </graphic>
        </Button>

        <Button fx:id="btnExit"
                styleClass="window-control-btn, btn-exit"
                prefWidth="32"
                prefHeight="32"
                minWidth="32"
                minHeight="32"
                onAction="#handleExitWindow">
            <graphic>
                <SVGPath content="M18 6L6 18 M6 6l12 12"
                         styleClass="window-control-icon"/>
            </graphic>
        </Button>
    </children>
</HBox>

            </children>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
    <VBox prefWidth="280"
          spacing="20"
          styleClass="sidebar">

        <children>

            <!-- CORPUS INPUT -->
            <VBox spacing="8">

                <children>

                    <Label text="CORPUS INPUT"
                           styleClass="section-header"/>

                    <TextArea fx:id="corpusInput"
                              wrapText="true"
                              prefHeight="150"
                              styleClass="corpus-textarea"/>

                    <HBox spacing="10" maxWidth="Infinity" HBox.hgrow="ALWAYS">

    <children>

        <!-- PROCESS (expands) -->
        <Button styleClass="btn-process"
                text="Process"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS"
        onAction="#handleProcessExecution">

            <graphic>
                <SVGPath content="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
                         stroke="#FFFFFF"
                         strokeWidth="2"
                         fill="transparent"/>
            </graphic>
        </Button>

        <!-- CLEAR (fixed size) -->
        <Button styleClass="btn-clear"
                prefWidth="44"
                prefHeight="44"
                minWidth="44"
                minHeight="44"
                maxWidth="44"
                maxHeight="44"
                onAction="#handleClearInput">

            <graphic>
                <SVGPath content="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6
                                 M3 6h18
                                 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                         strokeWidth="2"
                         fill="transparent"
                         strokeLineCap="ROUND"
                         strokeLineJoin="ROUND"/>
            </graphic>
        </Button>

    </children>
</HBox>

                </children>
            </VBox>

            <!-- NAVIGATION -->
            <VBox spacing="5">
    <children>
        <Label text="NAVIGATION" styleClass="section-header"/>

        <Button fx:id="btnDashboard"
                text="Dashboard"
                styleClass="nav-button, active-nav"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="16"
                onAction="#handleNavigation">
            <graphic>
                <SVGPath content="M3 4a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zm11 0a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1zm0 9a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1zM3 17a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"
                         styleClass="nav-icon"/>
            </graphic>
        </Button>
    </children>
</VBox>

<VBox spacing="5">
    <children>
        <Label text="NLP FEATURES" styleClass="section-header"/>

        <Button fx:id="btnTokenization"
                text="Tokenization"
                styleClass="nav-button"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="16"
                onAction="#handleNavigation">
            <graphic>
                <SVGPath content="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z M7 8a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"
                         styleClass="nav-icon"/>
            </graphic>
        </Button>

        <Button fx:id="btnLemmatization"
                text="Lemmatization"
                styleClass="nav-button"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="16"
                onAction="#handleNavigation">
            <graphic>
                <SVGPath content="M15 3v18 M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M21 9H3 M21 15H3"
                         styleClass="nav-icon"/>
            </graphic>
        </Button>

        <Button fx:id="btnPosTagging"
                text="POS Tagging"
                styleClass="nav-button"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="16"
                onAction="#handleNavigation">
            <graphic>
                <SVGPath content="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20 M8 13l4-7 4 7 M9.1 11h5.7"
                         styleClass="nav-icon"/>
            </graphic>
        </Button>

        <Button fx:id="btnSentiment"
                text="Sentiment Analysis"
                styleClass="nav-button"
                maxWidth="Infinity"
                contentDisplay="LEFT"
                graphicTextGap="16"
                onAction="#handleNavigation">
            <graphic>
                <SVGPath content="M21 9a2.4 2.4 0 0 0-.706-1.706l-3.588-3.588A2.4 2.4 0 0 0 15 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z M15 3v5a1 1 0 0 0 1 1h5 M8 13h.01 M16 13h.01 M10 16s.8 1 2 1c1.3 0 2-1 2-1"
                         styleClass="nav-icon"/>
            </graphic>
        </Button>
    </children>
</VBox>

        </children>
    </VBox>
</left>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="content-scrollpane">

            <content>
                <VBox fx:id="contentArea"
                      spacing="25"
                      styleClass="dashboard-body">

                    <children>
                        <fx:include source="dashboard.fxml"/>
                        <fx:include source="tokenization.fxml"/>
                        <fx:include source="lemmatization.fxml"/>
                    </children>

                </VBox>
            </content>

        </ScrollPane>
    </center>

</BorderPane>