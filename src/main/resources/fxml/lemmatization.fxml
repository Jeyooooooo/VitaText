<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="24.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" VBox.vgrow="ALWAYS">
   <children>
      
      <HBox alignment="CENTER_LEFT">
         <children>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Lemmatization" styleClass="section-title"/>
                  <Label text="Base form reduction with morphological analysis" styleClass="section-subtitle"/>
               </children>
            </VBox>
            <HBox styleClass="dash-tool-chips" spacing="6.0" alignment="CENTER_RIGHT">
               <children>
                  <HBox styleClass="dash-tool-chip" spacing="5.0" alignment="CENTER">
                     <children>
                        <Label text="⚙  CORE CONTEXT" style="-fx-font-weight: 700; -fx-text-fill: #1565C0;"/>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </HBox>
      
      <VBox styleClass="feature-card" spacing="12.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 4 0;">
               <children>
                  <Label text="☷  TOKEN ➜ LEMMA DICTIONARY MAP" styleClass="stat-chip-label"/>
               </children>
            </HBox>
            
            <TableView fx:id="lemmatizationTable" prefHeight="520.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" text="#" prefWidth="60.0" style="-fx-alignment: center-left;">
                     <cellValueFactory>
                        <PropertyValueFactory property="id"/>
                     </cellValueFactory>
                  </TableColumn>
                  
                  <TableColumn fx:id="colOriginalWord" text="Original Word" prefWidth="240.0" style="-fx-alignment: center-left;">
                     <cellValueFactory>
                        <PropertyValueFactory property="originalWord"/>
                     </cellValueFactory>
                  </TableColumn>
                  
                  <TableColumn fx:id="colPosTag" text="POS Tag" prefWidth="180.0" style="-fx-alignment: center-left;">
                     <cellValueFactory>
                        <PropertyValueFactory property="posTag"/>
                     </cellValueFactory>
                  </TableColumn>
                  
                  <TableColumn fx:id="colLemma" text="Lemma Base Form" prefWidth="280.0" style="-fx-alignment: center-left;">
                     <cellValueFactory>
                        <PropertyValueFactory property="lemma"/>
                     </cellValueFactory>
                  </TableColumn>
               </columns>
               
<!--               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>-->
            </TableView>
         </children>
      </VBox>
      
   </children>
</VBox>